[configuration]

entry_symbol = "example_library_init"
; Must match GODOTCPP_API_VERSION in CMakeLists.txt.
compatibility_minimum = "4.3"

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
; File names follow godot-cpp's suffix: <name>.<platform>.<target>[.double].<arch>
macos.debug = "./macos/godot_rtmidi.macos.template_debug.universal.dylib"
macos.release = "./macos/godot_rtmidi.macos.template_release.universal.dylib"
macos.double.debug = "./macos/godot_rtmidi.macos.template_debug.double.universal.dylib"
macos.double.release = "./macos/godot_rtmidi.macos.template_release.double.universal.dylib"

; iOS libraries must be packaged as (signed) xcframeworks.
ios.debug = "./ios/godot_rtmidi.ios.template_debug.xcframework"
ios.release = "./ios/godot_rtmidi.ios.template_release.xcframework"
ios.double.debug = "./ios/godot_rtmidi.ios.template_debug.double.xcframework"
ios.double.release = "./ios/godot_rtmidi.ios.template_release.double.xcframework"

windows.x86_32.debug = "./windows/godot_rtmidi.windows.template_debug.x86_32.dll"
windows.x86_32.release = "./windows/godot_rtmidi.windows.template_release.x86_32.dll"
windows.x86_32.double.debug = "./windows/godot_rtmidi.windows.template_debug.double.x86_32.dll"
windows.x86_32.double.release = "./windows/godot_rtmidi.windows.template_release.double.x86_32.dll"

windows.x86_64.debug = "./windows/godot_rtmidi.windows.template_debug.x86_64.dll"
windows.x86_64.release = "./windows/godot_rtmidi.windows.template_release.x86_64.dll"
windows.x86_64.double.debug = "./windows/godot_rtmidi.windows.template_debug.double.x86_64.dll"
windows.x86_64.double.release = "./windows/godot_rtmidi.windows.template_release.double.x86_64.dll"

linux.x86_64.debug = "./linux/godot_rtmidi.linux.template_debug.x86_64.so"
linux.x86_64.release = "./linux/godot_rtmidi.linux.template_release.x86_64.so"
linux.x86_64.double.debug = "./linux/godot_rtmidi.linux.template_debug.double.x86_64.so"
linux.x86_64.double.release = "./linux/godot_rtmidi.linux.template_release.double.x86_64.so"

linux.arm64.debug = "./linux/godot_rtmidi.linux.template_debug.arm64.so"
linux.arm64.release = "./linux/godot_rtmidi.linux.template_release.arm64.so"
linux.arm64.double.debug = "./linux/godot_rtmidi.linux.template_debug.double.arm64.so"
linux.arm64.double.release = "./linux/godot_rtmidi.linux.template_release.double.arm64.so"

linux.rv64.debug = "./linux/godot_rtmidi.linux.template_debug.rv64.so"
linux.rv64.release = "./linux/godot_rtmidi.linux.template_release.rv64.so"
linux.rv64.double.debug = "./linux/godot_rtmidi.linux.template_debug.double.rv64.so"
linux.rv64.double.release = "./linux/godot_rtmidi.linux.template_release.double.rv64.so"

android.x86_64.debug = "./android/godot_rtmidi.android.template_debug.x86_64.so"
android.x86_64.release = "./android/godot_rtmidi.android.template_release.x86_64.so"
android.x86_64.double.debug = "./android/godot_rtmidi.android.template_debug.double.x86_64.so"
android.x86_64.double.release = "./android/godot_rtmidi.android.template_release.double.x86_64.so"

android.arm64.debug = "./android/godot_rtmidi.android.template_debug.arm64.so"
android.arm64.release = "./android/godot_rtmidi.android.template_release.arm64.so"
android.arm64.double.debug = "./android/godot_rtmidi.android.template_debug.double.arm64.so"
android.arm64.double.release = "./android/godot_rtmidi.android.template_release.double.arm64.so"
