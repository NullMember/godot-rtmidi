<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest of godot_rtmidi.aar. Android's MIDI API (AMidi), which the native
     library uses, needs API level 29. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.godotrtmidi.rtmidi">
    <uses-sdk android:minSdkVersion="29" />

    <!-- Bluetooth MIDI device picker (MidiIn/MidiOut.show_bluetooth_devices). Optional:
         the app still installs on devices without it. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <application>
        <!-- Godot Android plugin (v2) registration. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.GodotRtMidi"
            android:value="org.godotrtmidi.GodotRtMidiPlugin" />
    </application>
</manifest>
